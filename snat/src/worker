#!/bin/sh
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
BASE=${SNAT_BASE:-}
[ -z "$BASE" ] || PATH="$BASE/mock-bin:$PATH"
case "${1:-}" in 4|6) family=$1;; *) exit 2;; esac
STATE="$BASE/var/run/sysu-snat/ipv$family"
ENGINE="$BASE/usr/libexec/sysu-snat/ipv$family"
umask 077
mkdir -p "$STATE"
exec 8>"$STATE/worker.lock"
flock -n 8 || exit 1
echo $$ > "$STATE/worker.pid"
stopping=0; wake=0; child=; sleeper=
signal_stop() {
    stopping=1
    [ -z "$child" ] || kill "$child" 2>/dev/null || :
    [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null || :
}
signal_wake() {
    wake=1
    [ -z "$sleeper" ] || kill "$sleeper" 2>/dev/null || :
}
trap signal_stop TERM INT HUP
trap signal_wake USR1
cleanup() {
    [ -z "$child" ] || { kill "$child" 2>/dev/null || :; wait "$child" 2>/dev/null || :; }
    SNAT_CONFIG_DIR="$(readlink -f "$BASE/var/run/sysu-snat/config")" "$ENGINE" clear >/dev/null 2>&1
    rm -f "$STATE/worker.pid" "$STATE/building" "$STATE/refresh" "$STATE/config-inuse"
    [ ! -x "$BASE/usr/libexec/sysu-snat/dns" ] || "$BASE/usr/libexec/sysu-snat/dns" release
}
trap cleanup EXIT
logger -t sysu-snat "IPv$family 服务已启动"
while [ "$stopping" = 0 ]; do
    wake=0
    exec 7>"$BASE/var/run/sysu-snat/config.lock"
    flock 7
    SNAT_CONFIG_DIR="$(readlink -f "$BASE/var/run/sysu-snat/config")"
    printf '%s\n' "$SNAT_CONFIG_DIR" > "$STATE/config-inuse"
    flock -u 7
    export SNAT_CONFIG_DIR
    CHECK_INTERVAL=60
    . "$SNAT_CONFIG_DIR/ipv$family.conf"
    if "$BASE/usr/libexec/sysu-snat/dns" sync; then
        mode=check
        if [ -f "$STATE/refresh" ]; then rm -f "$STATE/refresh"; mode=refresh; fi
        "$ENGINE" "$mode" >"$STATE/last-output" 2>&1 &
        child=$!
        [ "$stopping" = 0 ] || kill "$child" 2>/dev/null || :
        # 信号可能中断 wait，必须等清理结束后再退出或进入下一轮。
        while :; do
            wait "$child" 2>/dev/null
            result=$?
            kill -0 "$child" 2>/dev/null || break
        done
        child=
        [ "$stopping" = 0 ] || break
        if [ "$result" = 0 ]; then
            "$ENGINE" rules >>"$STATE/last-output" 2>&1 || logger -p user.err -t sysu-snat "IPv$family 策略应用失败，请查看状态"
        fi
    fi
    [ "$stopping" = 0 ] || break
    [ "$wake" = 0 ] || continue
    sleep "$CHECK_INTERVAL" &
    sleeper=$!
    if [ "$wake" != 0 ] || [ "$stopping" != 0 ]; then kill "$sleeper" 2>/dev/null || :; fi
    wait "$sleeper" 2>/dev/null || :
    sleeper=
done
