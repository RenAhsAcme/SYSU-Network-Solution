config service 'main'
	option enabled '0'
	option log_mode 'normal'
	option check_interval '60'
	option proxy_enabled '0'
	option proxy_gid ''
	option tailscale_enabled '0'
	option tailscale_device 'tailscale0'
	option tailscale_ipv4 '100.64.0.0/10'
	option tailscale_ipv6 'fd7a:115c:a1e0::/48'

config family 'ipv4'
	option enabled '1'
	option wan 'wan'
	option lan 'lan'
	option primary ''
	option probe_url 'https://www.baidu.com/'
	option parallel '8'
	option retry_seconds '300'
	option fallback 'primary'
	option lan_tcp 'random'
	option lan_udp 'random'
	option lan_other 'random'
	option proxy_tcp 'random'
	option proxy_udp 'random'
	option proxy_other 'random'
	option tailscale_tcp 'random'
	option tailscale_udp 'endpoint'
	option tailscale_other 'host'

config family 'ipv6'
	option enabled '1'
	option wan 'wan6'
	option lan 'lan'
	option primary ''
	option probe_url 'https://mirrors.ustc.edu.cn/'
	option pool_size '254'
	option parallel '8'
	option retry_seconds '300'
	option fallback 'primary'
	option lan_tcp 'random'
	option lan_udp 'random'
	option lan_other 'random'
	option proxy_tcp 'random'
	option proxy_udp 'random'
	option proxy_other 'random'
	option tailscale_tcp 'random'
	option tailscale_udp 'endpoint'
	option tailscale_other 'host'
