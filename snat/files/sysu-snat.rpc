#!/bin/sh
. /usr/share/libubox/jshn.sh
case "$1" in
list) printf '%s\n' '{"status":{},"members":{},"events":{},"operation":{},"logs":{},"control":{"action":""}}';;
call)
    case "$2" in
    status|members|events|operation) exec /usr/bin/ucode /usr/libexec/sysu-snat/v2/status.uc "$2";;
    logs)
        json_init
        json_add_string text "$(logread -e sysu-snat 2>/dev/null | grep -E ' sysu-snat(\[[0-9]+\])?:' | tail -n 80)"
        json_dump;;
    control)
        read -r request
        [ "${#request}" -le 512 ] || exit 1
        json_load "$request" || exit 1
        json_get_var action action
        mkdir -p /var/run/sysu-snat/v2
        exec /usr/bin/flock -n /var/run/sysu-snat/v2/control.lock /usr/bin/ucode /usr/libexec/sysu-snat/v2/control.uc "$action"
        ;;
    *) exit 1;;
    esac;;
*) exit 1;;
esac
