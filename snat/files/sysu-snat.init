#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

prepare_config() {
    local stage
    umask 077
    mkdir -p /var/run/sysu-snat || return 1
    chmod 0700 /var/run/sysu-snat
    exec 7>/var/run/sysu-snat/config.lock
    flock 7 || return 1
    stage="$(mktemp -d /var/run/sysu-snat/config.XXXXXX)" || { flock -u 7; return 1; }
    if ! /usr/bin/ucode /usr/libexec/sysu-snat/v2/config.uc stage "$stage"; then
        rm -f "$stage/policy.json"
        rmdir "$stage"
        logger -t sysu-snat '配置校验失败，保留当前运行配置'
        flock -u 7
        return 1
    fi
    if cmp -s "$stage/policy.json" /var/run/sysu-snat/config/policy.json; then
        rm -f "$stage/policy.json"
        rmdir "$stage"
        flock -u 7
        return 0
    fi
    rm -f /var/run/sysu-snat/config.next
    ln -s "$stage" /var/run/sysu-snat/config.next || { flock -u 7; return 1; }
    mv -Tf /var/run/sysu-snat/config.next /var/run/sysu-snat/config || { flock -u 7; return 1; }
    local previous
    for previous in /var/run/sysu-snat/config.*; do
        [ -d "$previous" ] && [ ! -L "$previous" ] && [ "$previous" != "$stage" ] || continue
        rm -f "$previous/policy.json"
        rmdir "$previous" 2>/dev/null || :
    done
    flock -u 7
}

start_service() {
    local enabled
    config_load sysu-snat
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || { disable; return 0; }
    # rc.common 不传递 start_service 的失败；退出可避免提交空实例列表。
    prepare_config || exit 1
    /usr/libexec/sysu-snat/dns sync || exit 1
    enabled || enable || exit 1
    mkdir -p /var/run/sysu-snat/v2
    chmod 0700 /var/run/sysu-snat/v2
    procd_open_instance controller
    procd_set_param command /usr/libexec/sysu-snat/net-helper supervise /usr/bin/ucode /usr/libexec/sysu-snat/v2/daemon.uc
    procd_set_param respawn 3600 3 0
    procd_set_param term_timeout 120
    procd_set_param limits core="0 0"
    procd_close_instance
}

reload_service() {
    local active
    config_load sysu-snat
    config_get_bool active main enabled 0
    if [ "$active" != 1 ]; then stop; disable; return 0; fi
    prepare_config || return 1
    start || return 1
    procd_send_signal sysu-snat '*' USR1 || :
}

stop_service() {
    [ ! -f /var/run/sysu-snat/v2/upgrade-preserve ] || exit 0
    logger -t sysu-snat '停止服务，释放插件持有的地址、规则与路由'
    [ -f /var/run/sysu-snat/v2/daemon.pid ] || return 0
    printf 'stop\n' > /var/run/sysu-snat/v2/request
    local n
    for n in $(seq 1 120); do
        [ -f /var/run/sysu-snat/v2/daemon.pid ] || return 0
        sleep 1
    done
    logger -t sysu-snat '清理尚未完成，保留资源记录供下次恢复'
}

service_stopped() {
    (trap '' HUP; /usr/libexec/sysu-snat/dns release-wait) </dev/null >/dev/null 2>&1 &
}

service_triggers() {
    local family iface
    procd_add_reload_trigger sysu-snat
    config_load sysu-snat
    for family in ipv4 ipv6; do
        for iface in wan lan; do
            local name
            config_get name "$family" "$iface"
            [ -z "$name" ] || procd_add_interface_trigger 'interface.*' "$name" /etc/init.d/sysu-snat wake
        done
    done
    procd_add_reload_trigger firewall dhcp
}

wake() {
    /usr/libexec/sysu-snat/dns sync || return 1
    procd_send_signal sysu-snat '*' USR1
}
rebuild() {
    mkdir -p /var/run/sysu-snat/v2
    printf 'rotate\n' > /var/run/sysu-snat/v2/request
    wake
}
extra_command wake 'Check interface and rule changes'
extra_command rebuild 'Rebuild enabled pools asynchronously'
prepare() { prepare_config; }
extra_command prepare 'Validate and prepare runtime configuration'
