#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

prepare_config() {
    local device username password heartbeat stage_timeout retry_delay max_retries log_mode debug runtime
    config_load sysu-auth
    if pidof minieap >/dev/null; then
        logger -t sysu-auth '旧版 MiniEAP 正在运行，请先手动停用它'
        return 1
    fi
    config_get device main device
    config_get username main username
    config_get password main password
    config_get heartbeat main heartbeat 0
    config_get stage_timeout main stage_timeout 5
    config_get retry_delay main retry_delay 30
    config_get max_retries main max_retries 3
    config_get log_mode main log_mode normal
    case "$log_mode" in
        normal) debug=0 ;;
        debug) debug=1 ;;
        *) logger -t sysu-auth '日志模式无效'; return 1 ;;
    esac
    local value
    for value in "$username" "$password" "$device" "$heartbeat" "$stage_timeout" "$retry_delay" "$max_retries"; do
        if printf '%s' "$value" | LC_ALL=C grep -q '[[:cntrl:]]'; then
            logger -t sysu-auth '配置包含控制字符，拒绝启动'
            return 1
        fi
    done
    umask 077
    chmod 0600 /etc/config/sysu-auth || return 1
    mkdir -p /var/etc /var/run/sysu-auth || return 1
    chmod 0700 /var/run/sysu-auth || return 1
    chown sysu-auth:sysu-auth /var/run/sysu-auth || return 1
    runtime="$(mktemp /var/etc/sysu-auth.XXXXXX)" || return 1
    {
        printf 'username=%s\npassword=%s\nnic=%s\n' "$username" "$password" "$device"
        printf 'heartbeat=%s\nstage-timeout=%s\nwait-after-fail=%s\nmax-retries=%s\n' \
            "$heartbeat" "$stage_timeout" "$retry_delay" "$max_retries"
        printf 'debug=%s\n' "$debug"
    } >"$runtime"
    if ! /usr/sbin/sysu-auth --conf-file "$runtime" --check >/dev/null; then
        rm -f "$runtime"
        logger -t sysu-auth '配置校验失败，未启动认证'
        return 1
    fi
    printf '%s\n' "$runtime"
}

start_service() {
    local enabled runtime
    config_load sysu-auth
    config_get_bool enabled main enabled 0
    if [ "$enabled" != 1 ]; then
        disable
        return 0
    fi
    enabled || enable || return 1
    runtime="$(prepare_config)" || return 1
    mv -f "$runtime" /var/etc/sysu-auth.conf || { rm -f "$runtime"; return 1; }
    procd_open_instance main
    procd_set_param command /usr/sbin/sysu-auth --conf-file /var/etc/sysu-auth.conf
    procd_set_param respawn 3600 30 0
    procd_set_param term_timeout 5
    procd_set_param limits core="0 0"
    procd_close_instance
}

stop_service() {
    logger -t sysu-auth '停止认证服务'
    rm -f /var/etc/sysu-auth.conf
}

reload_service() {
    local enabled runtime
    config_load sysu-auth
    config_get_bool enabled main enabled 0
    if [ "$enabled" != 1 ]; then
        stop
        disable
        return $?
    fi
    enabled || enable || return 1
    runtime="$(prepare_config)" || return 1
    if cmp -s "$runtime" /var/etc/sysu-auth.conf && running; then
        rm -f "$runtime"
        return 0
    fi
    rm -f "$runtime"
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger sysu-auth
}
