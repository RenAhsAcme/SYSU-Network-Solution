#!/bin/sh
set -u
PATH=/usr/sbin:/usr/bin:/sbin:/bin
BASE=${AWP6_BASE:-}
[ -z "$BASE" ] || PATH="$BASE/mock-bin:$PATH"
CONFIG_DIR=${SNAT_CONFIG_DIR:-$BASE/var/run/sysu-snat/config}
CONF="$CONFIG_DIR/ipv6.conf"
STATE="$BASE/var/run/sysu-snat/ipv6"
CALC="$BASE/usr/lib/sysu-snat/netcalc6.lua"
ENABLED=0;WAN_IF=wan6;LAN_IF=lan;POOL_SIZE=254;PARALLEL=8;RETRY_SECONDS=300;PRIMARY=;LOG_MODE=normal;TAILSCALE_ENABLED=0;TAILSCALE_PREFIX=fd7a:115c:a1e0::/48;PROXY_GID=
PROBE_URL=https://www.baidu.com/
[ ! -f "$CONF" ] || . "$CONF"
umask 077
mkdir -p "$STATE" || exit 1
progress() { [ "$LOG_MODE" != debug ] || logger -p user.debug -t sysu-snat "IPv6: $1"; printf '%s\n' "$1"; }
log() { logger -p "user.${2:-notice}" -t sysu-snat "$1"; printf '%s\n' "$1"; }
field() { printf '%s' "$1" | jsonfilter -e "$2"; }
snapshot() {
    w=$(ubus call "network.interface.$WAN_IF" status 2>/dev/null) || return 1
    [ "$(field "$w" '@.up')" = true ] || return 1
    DEV=$(field "$w" '@.l3_device')
    lua "$(dirname "$CALC")/native.lua" 6 "$WAN_IF" "$PRIMARY" > "$STATE/native" 2> "$STATE/plan-error" || return 1
    read -r WAN_IP mask < "$STATE/native"
    GW=$(field "$w" '@.route[@.target="::"].nexthop')
    case "$DEV" in ''|*[!a-zA-Z0-9_.:-]*) return 1;; esac
    case "$GW" in fe80:*) ;; *) return 1;; esac
    l=$(ubus call "network.interface.$LAN_IF" status 2>/dev/null) || return 1
    [ "$(field "$l" '@.up')" = true ] || return 1
    LANDEV=$(field "$l" '@.l3_device')
    case "$LANDEV" in ''|*[!a-zA-Z0-9_.:-]*) return 1;; esac
    LAN_IP=$(field "$l" '@["ipv6-prefix-assignment"][0].address')
    lanmask=$(field "$l" '@["ipv6-prefix-assignment"][0].mask')
    lua "$CALC" plan "$WAN_IP" "$mask" "$LAN_IP" "$lanmask" > "$STATE/plan" 2> "$STATE/plan-error" || return 1
    read -r WAN_CIDR LAN_CIDR < "$STATE/plan"
    cfgsum=$(printf '%s\n' "$PROBE_URL" "$POOL_SIZE" | sha256sum) || return 1
    SIGNATURE="$DEV $WAN_IP $GW $LANDEV $LAN_CIDR $WAN_CIDR $cfgsum"
}
clear_pool() {
    nft delete table ip6 awp6_auto 2>/dev/null || :
    nft delete table ip6 awp6_probe 2>/dev/null || :
    if [ -f "$STATE/return-route-owned" ]; then
        read -r rd rl rp < "$STATE/return-route-owned"
        ip -6 rule del priority 32000 iif "$rd" to "$rp" lookup 40960 2>/dev/null || :
        ip -6 route del "$rp" dev "$rl" table 40960 metric 4096 2>/dev/null || :
        rm -f "$STATE/return-route-owned"
    fi
    if [ -f "$STATE/tail-route-owned" ]; then
        read -r td tg tp < "$STATE/tail-route-owned"
        tp=${tp:-fd7a:115c:a1e0::/48}
        ip -6 route del default from "$tp" via "$tg" dev "$td" metric 4096 2>/dev/null || :
        rm -f "$STATE/tail-route-owned"
    fi
    if [ -f "$STATE/route-owned" ]; then
        read -r rd rl rg < "$STATE/route-owned"
        ip -6 route del default from "$rl" via "$rg" dev "$rd" metric 4096 2>/dev/null || :
        rm -f "$STATE/route-owned"
    fi
    if [ -f "$STATE/owned" ]; then
        while read -r dev addr; do ip -6 addr del "$addr/128" dev "$dev" 2>/dev/null || :; done < "$STATE/owned"
    fi
    : > "$STATE/owned"
    rm -f "$STATE/active" "$STATE/signature" "$STATE/fallback"
}
install_rules() {
    local kind=${1:-pool}
    lua "$(dirname "$CALC")/compile.lua" rules "$CONFIG_DIR/policy.json" "$STATE" 6 "$DEV" "$LAN_CIDR" "$WAN_CIDR" "$LANDEV" "$kind" "$WAN_IP" > "$STATE/rules.next" || return 1
    if cmp -s "$STATE/rules.next" "$STATE/rules.nft" && nft list table ip6 awp6_auto >/dev/null 2>&1; then return 0; fi
    nft -c -f "$STATE/rules.next" || return 1
    nft -f "$STATE/rules.next" || return 1
    mv "$STATE/rules.next" "$STATE/rules.nft"
}
install_fallback() {
    ensure_route || { clear_pool; return 1; }
    install_rules fallback || { clear_pool; return 1; }
    touch "$STATE/fallback"
}

ensure_route() {
    route_changed=0
    if [ -f "$STATE/tail-route-owned" ]; then
        read -r td tg tp < "$STATE/tail-route-owned"
        tp=${tp:-fd7a:115c:a1e0::/48}
        if [ "$TAILSCALE_ENABLED" != 1 ] || [ "$tp" != "$TAILSCALE_PREFIX" ] || [ "$td" != "$DEV" ] || [ "$tg" != "$GW" ]; then
            ip -6 route del default from "$tp" via "$tg" dev "$td" metric 4096 2>/dev/null || :
            rm -f "$STATE/tail-route-owned"
        fi
    fi
    if [ "$TAILSCALE_ENABLED" = 1 ] && ! ip -6 route show default from "$TAILSCALE_PREFIX" dev "$DEV" | grep -q "via $GW .*metric 4096"; then
        printf '%s %s %s\n' "$DEV" "$GW" "$TAILSCALE_PREFIX" > "$STATE/tail-route-owned"
        ip -6 route add default from "$TAILSCALE_PREFIX" via "$GW" dev "$DEV" metric 4096 || return 1
        route_changed=1
    fi
    if ! ip -6 route show default from "$LAN_CIDR" dev "$DEV" | grep -q "via $GW .*metric 4096"; then
        printf '%s %s %s\n' "$DEV" "$LAN_CIDR" "$GW" > "$STATE/route-owned"
        ip -6 route add default from "$LAN_CIDR" via "$GW" dev "$DEV" metric 4096 || return 1
        route_changed=1
    fi
    if [ ! -f "$STATE/return-route-owned" ]; then
        if [ -n "$(ip -6 route show table 40960 2>/dev/null)" ] || [ -n "$(ip -6 rule show priority 32000)" ]; then
            log 'IPv6 回程路由表 40960 或优先级 32000 已被占用，停止构建。' err
            return 1
        fi
        printf '%s %s %s\n' "$DEV" "$LANDEV" "$WAN_CIDR" > "$STATE/return-route-owned"
    fi
    # 共享 /64 的 NAT66 回包必须回到 LAN，不能依赖会老化的 NDP 主机路由。
    if ! ip -6 route show table 40960 exact "$WAN_CIDR" dev "$LANDEV" | grep -q 'metric 4096'; then
        ip -6 route replace "$WAN_CIDR" dev "$LANDEV" table 40960 metric 4096 || return 1
        route_changed=1
    fi
    if [ -z "$(ip -6 rule show priority 32000 iif "$DEV" to "$WAN_CIDR" lookup 40960)" ]; then
        ip -6 rule add priority 32000 iif "$DEV" to "$WAN_CIDR" lookup 40960 || return 1
        route_changed=1
    fi
    [ "$route_changed" -eq 0 ] || log 'IPv6 地址池出口及回程路由已恢复。'
}
still_current() {
    expected=$SIGNATURE
    if snapshot && [ "$SIGNATURE" = "$expected" ];then return 0;fi
    SIGNATURE=$expected
    return 1
}
mode=${1:-status}
case "$mode" in
 status)
    if [ -f "$STATE/active" ]; then printf 'Active: ';cat "$STATE/signature";printf 'Pool size: ';wc -l < "$STATE/pool";else echo 'IPv6 pool is inactive';fi
    exit 0;;
 plan) snapshot || exit 1;printf 'WAN=%s LAN=%s TARGET_SIZE=%s\n' "$WAN_CIDR" "$LAN_CIDR" "$POOL_SIZE";exit 0;;
 check|refresh|clear|rules|adopt) ;;
 *) echo 'Usage: wan-ipv6-pool-auto check|refresh|clear|plan|status';exit 2;;
esac
exec 9> "$STATE/lock"
if [ "$mode" = clear ]; then flock 9 || exit 1;else flock -n 9 || exit 0;fi
[ "$mode" != clear ] || { clear_pool;log 'IPv6 地址池及本项目路由已清理。';exit 0; }
[ "$ENABLED" = 1 ] || { clear_pool;exit 0; }
case "$POOL_SIZE" in ''|*[!0-9]*) exit 1;; esac
[ "$POOL_SIZE" -ge 1 ] && [ "$POOL_SIZE" -le 512 ] || exit 1
case "$PARALLEL" in 1|2|4|8) ;; *) exit 1;; esac
case "$RETRY_SECONDS" in ''|*[!0-9]*) exit 1;; esac
if ! snapshot; then clear_pool;[ -f "$STATE/unavailable" ] || log "IPv6 WAN 未就绪或前缀不支持，维持原 IPv6 配置。$(cat "$STATE/plan-error" 2>/dev/null)" warn;touch "$STATE/unavailable";exit 0;fi
rm -f "$STATE/unavailable"
if [ "$mode" = adopt ]; then
    [ -s "$STATE/pool" ] && [ -f "$STATE/active" ] || exit 1
    ip -o -6 addr show dev "$DEV" | awk '$3=="inet6" && $0 !~ /tentative|dadfailed/ {print $4}' | lua "$CALC" normalize > "$STATE/present"
    while read -r a; do
        grep -qxF "$a" "$STATE/present" || exit 1
    done < "$STATE/pool"
    ensure_route || exit 1
    install_rules || exit 1
    printf '%s\n' "$SIGNATURE" > "$STATE/signature"
    exit 0
fi
if [ "$mode" = rules ]; then
    ensure_route || exit 1
    if [ -f "$STATE/active" ]; then install_rules; else install_fallback; fi
    exit $?
fi

if [ "$mode" = check ] && [ -f "$STATE/active" ] && [ "$(cat "$STATE/signature")" = "$SIGNATURE" ]; then
    ip -o -6 addr show dev "$DEV" | awk '$3=="inet6" && $0 !~ /tentative|dadfailed/ {print $4}' | lua "$CALC" normalize > "$STATE/present"
    missing=0
    while read -r addr; do grep -qxF "$addr" "$STATE/present" || missing=1;done < "$STATE/pool"
    if [ "$missing" -eq 0 ]; then
        if ! nft list table ip6 awp6_auto >/dev/null 2>&1; then install_rules || { clear_pool;exit 1; };log '已恢复 IPv6 地址池 NAT 规则。';fi
        ensure_route || { clear_pool;log 'IPv6 ULA 出口路由恢复失败。' err;exit 1; }
        exit 0
    fi
fi
if [ "$mode" = check ] && [ -f "$STATE/failed-signature" ] && [ "$(cat "$STATE/failed-signature")" = "$SIGNATURE" ]; then
    remaining=$(( $(cat "$STATE/retry-at") - $(date +%s) ))
    [ "$remaining" -le 0 ] || exit 0
fi
clear_pool
rm -f "$STATE"/ok-* "$STATE"/error-*
: > "$STATE/pool"
touch "$STATE/building"
building=1;children=;phase=原IPv6检查
printf '%s\n' "$phase" > "$STATE/phase"
finish() {
    rm -f "$STATE/building"
    for pid in $children;do kill "$pid" 2>/dev/null || :;done
    for pid in $children;do wait "$pid" 2>/dev/null || :;done
    if [ "$building" -eq 1 ]; then
        clear_pool
        install_fallback || :
        printf '%s\n' "$SIGNATURE" > "$STATE/failed-signature"
        echo $(( $(date +%s)+RETRY_SECONDS )) > "$STATE/retry-at"
        log "IPv6 构建失败：阶段=$phase；已清理新增地址、规则和路由，保留原 IPv6。" err
    fi
}
trap finish EXIT
trap 'exit 130' INT TERM HUP
log "开始 IPv6 构建：前缀=$WAN_CIDR 接口=$DEV 目标规模=$POOL_SIZE。"
install_fallback || exit 1
TARGET=$(curl -6 --noproxy '*' --interface "$WAN_IP" -fsS -o /dev/null --connect-timeout 3 --max-time 8 -w '%{remote_ip}' "$PROBE_URL") || exit 1
printf '%s\n' "$TARGET" | lua "$CALC" normalize > "$STATE/target" || exit 1
TARGET=$(cat "$STATE/target")
if nft list chain inet fw4 openclash_mangle_output_v6 >/dev/null 2>&1; then
    nft get element inet fw4 china_ip6_route "{ $TARGET }" >/dev/null 2>&1 || { log 'IPv6 测试目标未确认直连，停止以避免代理假阳性。' err;exit 1; }
    if nft get element inet fw4 china_ip6_route_pass "{ $TARGET }" >/dev/null 2>&1;then log 'IPv6 测试目标命中代理排除集合，停止。' err;exit 1;fi
fi
progress "IPv6 原地址检查通过，测试目标=$TARGET；保留证书校验。"
phase=生成地址与DAD
printf '%s\n' "$phase" > "$STATE/phase"
lua "$CALC" generate "$WAN_IP" "$POOL_SIZE" > "$STATE/candidates" || exit 1
while read -r addr;do
    echo "$DEV $addr" >> "$STATE/owned"
    ip -6 addr add "$addr/128" dev "$DEV" || exit 1
done < "$STATE/candidates"
sleep 3
for n in 1 2 3 4 5;do
    ip -o -6 addr show dev "$DEV" | awk '/tentative/ {print $4}' > "$STATE/tentative"
    [ ! -s "$STATE/tentative" ] && break
    sleep 1
done
ip -o -6 addr show dev "$DEV" | awk '$3=="inet6" && $0 !~ /tentative|dadfailed/ {print $4}' | lua "$CALC" normalize > "$STATE/present"
: > "$STATE/ready"
while read -r addr;do grep -qxF "$addr" "$STATE/present" && echo "$addr" >> "$STATE/ready";done < "$STATE/candidates"
ready=$(wc -l < "$STATE/ready")
progress "IPv6 DAD 完成：可验证=$ready，冲突或未就绪=$((POOL_SIZE-ready))。"
[ "$ready" -gt 0 ] || exit 1
lua "$CALC" probe "$STATE/ready" "$DEV" > "$STATE/probe.nft" || exit 1
nft -c -f "$STATE/probe.nft" && nft -f "$STATE/probe.nft" || exit 1
phase=源IPv6验证
printf '%s\n' "$phase" > "$STATE/phase"
probe() {
    addr=$1
    if curl -6 --noproxy '*' --connect-to "::[$TARGET]:" --interface "$addr" -fsS -o /dev/null --connect-timeout 3 --max-time 5 "$PROBE_URL" 2> "$STATE/error-$addr";then
        echo "$addr" > "$STATE/ok-$addr";rm -f "$STATE/error-$addr"
    else progress "IPv6 验证失败：$addr；$(cat "$STATE/error-$addr")";fi
}
count=0;tested=0
collect() {
    for pid in $children;do wait "$pid" || :;done
    children=;tested=$((tested+count));count=0
    progress "IPv6 HTTPS 进度：$tested/$ready，通过=$(find "$STATE" -name 'ok-*' | wc -l)。"
    still_current
}
while read -r addr;do
    probe "$addr" & children="$children $!";count=$((count+1))
    if [ "$count" -ge "$PARALLEL" ];then collect || exit 1;fi
done < "$STATE/ready"
[ "$count" -eq 0 ] || collect || exit 1
for file in "$STATE"/ok-*;do [ ! -f "$file" ] || cat "$file";done > "$STATE/pool"
[ -s "$STATE/pool" ] || exit 1
: > "$STATE/owned.next"
while read -r dev addr;do
    if grep -qxF "$addr" "$STATE/pool";then echo "$dev $addr" >> "$STATE/owned.next";else ip -6 addr del "$addr/128" dev "$dev" || exit 1;fi
done < "$STATE/owned"
mv "$STATE/owned.next" "$STATE/owned"
phase=安装NAT66及路由
printf '%s\n' "$phase" > "$STATE/phase"
still_current && install_rules && ensure_route && still_current || exit 1
nft delete table ip6 awp6_probe || exit 1
printf '%s\n' "$SIGNATURE" > "$STATE/signature"
touch "$STATE/active"
rm -f "$STATE/failed-signature" "$STATE/retry-at"
building=0
date +%s > "$STATE/verified"
rm -f "$STATE/fallback"
log "IPv6 地址池已启用：$(wc -l < "$STATE/pool") 个；转换 LAN 公网地址及 ULA 的直连出口。"
